{
   "main" : {
      "controls" : [
         {
            "hold@mark_point_ready.hold": {}
         }
      ],
      "type" : "screen"
   },
   "check" : {
      "alpha" : "@mark_point_ready.mark_point_ready_alpha_keep",
      "controls" : [
         {
            "image" : {
               "alpha" : 1,
               "clip_direction" : "left",
               "clip_ratio" : 0.0,
               "layer" : 2,
               "size" : [ "100%", "100%" ],
               "texture" : "textures/ui/ec_mark/mark_rhombus_bg",
               "type" : "image"
            }
         },
         {
            "bg" : {
               "alpha" : "@mark_point_ready.mark_point_ready_bg_alpha",
               "clip_direction" : "left",
               "clip_ratio" : 0.0,
               "layer" : 1,
               "size" : "@mark_point_ready.mark_point_ready_bg_size",
               "texture" : "textures/ui/ec_mark/mark_rhombus_bg",
               "type" : "image"
            }
         }
      ],
      "layer" : 1,
      "propagate_alpha" : true,
      "size" : [ 6.0, 6.0 ],
      "type" : "panel"
   },
   "hold" : {
      "controls" : [
         {
            "image" : {
               "alpha" : 1,
               "clip_direction" : "left",
               "clip_ratio" : 0.0,
               "layer" : 2,
               "size" : [ "100%", "100%" ],
               "texture" : "textures/ui/ec_mark/mark_rhombus_bg",
               "type" : "image"
            }
         },
         {
            "hold_tip": {
               "anchor_from" : "top_middle",
               "anchor_to" : "bottom_middle",
               "type" : "image",
               "texture" : "textures/ui/hud_tip_text_background",
               "size": [ "100%cm + 8px", "100%cm + 4px"],
               "offset": [0.0, "-8px"],
               "alpha": "@mark_point_ready.mark_point_ready_tip_alpha",
               "controls": [
                  {
                     "hold_label": {
                        "anchor_from" : "center",
                        "anchor_to" : "center",
                        "type" : "label",
                        "text" : "松开放置标点",
                        "text_alignment" : "center",
                        "visible" : true,
                        "alpha": "@mark_point_ready.mark_point_ready_tip_label_alpha"
                     }
                  }
               ]
            }
         }
      ],
      "layer" : 1,
      "propagate_alpha" : true,
      "size" : [ 6.0, 6.0 ],
      "type" : "panel"
   },
   "mark_point_ready_tip_alpha" : {
      "anim_type" : "alpha",
      "duration" : 0.20,
      "from" : 0,
      "next" : "",
      "to" : 0.3
   },
   "mark_point_ready_tip_label_alpha" : {
      "anim_type" : "alpha",
      "duration" : 0.20,
      "from" : 0,
      "next" : "",
      "to" : 1.0
   },
   "mark_point_ready_alpha_keep" : {
      "anim_type" : "alpha",
      "duration" : 0.20,
      "from" : 0.50,
      "next" : "@mark_point_ready.mark_point_ready_alpha_out",
      "to" : 0.50
   },
   "mark_point_ready_alpha_out" : {
      "anim_type" : "alpha",
      "duration" : 0.40,
      "easing" : "in_sin",
      "from" : 0.50,
      "next" : "",
      "to" : 0.0
   },
   "mark_point_ready_bg_alpha" : {
      "anim_type" : "alpha",
      "duration" : 0.50,
      "easing" : "out_cubic",
      "from" : 0.0,
      "next" : "",
      "to" : 0.50
   },
   "mark_point_ready_bg_size" : {
      "anim_type" : "size",
      "duration" : 0.50,
      "easing" : "out_cubic",
      "from" : [ "500%", "500%" ],
      "next" : "",
      "to" : [ "100%", "100%" ]
   },
   "namespace" : "mark_point_ready"
}
